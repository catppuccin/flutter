---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "lib/src/flavors/{{flavor.identifier}}.dart"
  hex_format: "{{R}}{{G}}{{B}}{{Z}}"
---
import 'dart:ui';

import 'package:catppuccin_flutter/src/catppuccin_base.dart';

final Flavor {{flavor.identifier}} = (
  rosewater: Color(0xFF{{flavor.colors.rosewater.hex}}),
  base: Color(0xFF{{flavor.colors.base.hex}}),
  blue: Color(0xFF{{flavor.colors.blue.hex}}),
  crust: Color(0xFF{{flavor.colors.crust.hex}}),
  flamingo: Color(0xFF{{flavor.colors.flamingo.hex}}),
  green: Color(0xFF{{flavor.colors.green.hex}}),
  lavender: Color(0xFF{{flavor.colors.lavender.hex}}),
  mantle: Color(0xFF{{flavor.colors.mantle.hex}}),
  maroon: Color(0xFF{{flavor.colors.maroon.hex}}),
  mauve: Color(0xFF{{flavor.colors.mauve.hex}}),
  overlay0: Color(0xFF{{flavor.colors.overlay0.hex}}),
  overlay1: Color(0xFF{{flavor.colors.overlay1.hex}}),
  overlay2: Color(0xFF{{flavor.colors.overlay2.hex}}),
  peach: Color(0xFF{{flavor.colors.peach.hex}}),
  pink: Color(0xFF{{flavor.colors.pink.hex}}),
  red: Color(0xFF{{flavor.colors.red.hex}}),
  sapphire: Color(0xFF{{flavor.colors.sapphire.hex}}),
  sky: Color(0xFF{{flavor.colors.sky.hex}}),
  subtext0: Color(0xFF{{flavor.colors.subtext0.hex}}),
  subtext1: Color(0xFF{{flavor.colors.subtext1.hex}}),
  surface0: Color(0xFF{{flavor.colors.surface0.hex}}),
  surface1: Color(0xFF{{flavor.colors.surface1.hex}}),
  surface2: Color(0xFF{{flavor.colors.surface2.hex}}),
  teal: Color(0xFF{{flavor.colors.teal.hex}}),
  text: Color(0xFF{{flavor.colors.text.hex}}),
  yellow: Color(0xFF{{flavor.colors.yellow.hex}}),
);
